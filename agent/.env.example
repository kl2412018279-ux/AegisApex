# Copy to agent/.env. Never commit the real file.
SUPABASE_URL=https://your-project.supabase.co
# Service role key: the agent reads Vault credentials and writes results.
SUPABASE_SERVICE_ROLE_KEY=

# Optional tuning
AEGIS_WORKERS=5
AEGIS_POLL_SECONDS=5
AEGIS_SCHEDULE_SECONDS=60
# AEGIS_WORKER_ID=dc1-agent-1
# Refuse devices whose SSH host key has not been pinned out of band
# (default: pin on first contact).
AEGIS_REQUIRE_PINNED_HOST_KEYS=false
