# Copy to dashboard/.env.local (or set in Vercel). Never commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by API routes after they authorize the caller.
SUPABASE_SERVICE_ROLE_KEY=

# ── AI (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile

# ── Vulnerability intelligence ──────────────────────────────────────────────
# Optional but recommended: raises the NVD rate limit from 5 to 50 req / 30 s.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Optional: Cisco PSIRT openVuln advisories for IOS / IOS XE.
# https://developer.cisco.com/docs/psirt/
CISCO_OPENVULN_CLIENT_ID=
CISCO_OPENVULN_CLIENT_SECRET=

# ── Background jobs ─────────────────────────────────────────────────────────
# Vercel sends this as "Authorization: Bearer <CRON_SECRET>" to /api/cron/*.
CRON_SECRET=
# Used for links in alerts and digests.
APP_BASE_URL=https://aegisapex.example.com

# ── Alerts (org-wide channels can also be added in the Admin tab) ───────────
# Sent to every organization. Minimum severity for risk/drift alerts:
ALERT_MIN_SEVERITY=HIGH
ALERT_SLACK_WEBHOOK_URL=
ALERT_TEAMS_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
# Email via Resend (https://resend.com)
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
RESEND_API_KEY=
